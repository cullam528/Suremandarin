STRAPI_URL=http://127.0.0.1:1337
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
# Long enough for a Render cold start; keep this server-only.
STRAPI_REQUEST_TIMEOUT_MS=30000
NEXT_PUBLIC_SITE_URL=https://www.suremandarin.com
# Optional public ownership verification values, never passwords or API keys.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Keep false in production. Preview deployments are excluded automatically.
SEO_NOINDEX=false
# Required account protection. No defaults; do not copy production secrets locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact comma-separated hostnames; configure a separate widget for staging.
TURNSTILE_HOSTNAMES=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Stable across all instances/rolling releases; separate staging and production.
AUTH_RATE_LIMIT_PREFIX=
# Independent 32 random bytes encoded as 64 hex; same value on frontend and Strapi.
AUTH_GATEWAY_SECRET=
# Only for non-Vercel ingress that overwrites this header and prevents direct access.
# Without it, non-Vercel requests share an 'unknown' bucket (fail safely).
AUTH_TRUSTED_IP_HEADER=
