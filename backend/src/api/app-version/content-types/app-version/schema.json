    },
    "currentVersion": {
      "type": "string",
      "required": true
    },
    "minimumVersion": {
      "type": "string",
      "required": true
    },
    "downloadUrl": {
      "type": "string"
    },
    "forceUpdate": {
      "type": "boolean",
      "default": false
    },
    "releaseNotes": {
      "type": "text"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  }
}
