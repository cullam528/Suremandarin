{
  "kind": "collectionType",
  "collectionName": "app_versions",
  "info": {
    "singularName": "app-version",
    "pluralName": "app-versions",
    "displayName": "06 运营 · 客户端版本"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
