{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "02 课程 · 课程"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "private",
        "group",
        "learn-travel",
        "ib-tutorial",
        "online",
        "exclusive"
      ]
    },
    "summary": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "imageAlt": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "audience": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "level": {
      "type": "enumeration",
      "enum": [
        "all",
        "beginner",
        "intermediate",
        "advanced",
        "ib-sl",
        "ib-hl",
        "custom"
      ],
      "default": "all"
    },
    "deliveryMode": {
      "type": "enumeration",
      "enum": [
        "online",
        "offline",
        "hybrid",
        "travel"
      ]
    },
    "duration": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "highlights": {
      "type": "component",
      "component": "shared.feature-item",
      "repeatable": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "accessLevel": {
      "type": "enumeration",
      "enum": [
        "public",
        "registered",
        "vip",
        "svip"
      ],
      "default": "public"
    },
    "standalonePrice": {
      "type": "decimal"
    },
    "lessonHours": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "USD",
        "CNY",
        "EUR",
        "GBP"
      ],
      "default": "USD"
    },
    "allowStandalonePurchase": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "modules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::course-module.course-module",
      "mappedBy": "course"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
