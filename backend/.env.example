HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
CLIENT_ORIGINS=http://localhost:3000
CLIENT_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3010

# Referral rewards are reviewed after this refund window.
REFERRAL_REFUND_WINDOW_DAYS=7
CRON_ENABLED=true

# Transactional email through the Resend HTTPS API (port 443).
# Verify suremandarin.com in Resend before using hello@suremandarin.com.
RESEND_API_KEY=
EMAIL_FROM=SureMandarin <hello@suremandarin.com>
EMAIL_FROM_ADDRESS=hello@suremandarin.com
EMAIL_REPLY_TO=qingniaobird@163.com
ADMIN_NOTIFICATION_EMAIL=qingniaobird@163.com

APP_KEYS=replace-me-1,replace-me-2,replace-me-3,replace-me-4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Local development uses sqlite. Production should use postgres.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/suremandarin
# DATABASE_SSL=true

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
SEED_INITIAL_DATA=true

# Social login. Google and X return through Strapi. Apple returns to the
# Next.js form-post callback because Apple sends name/email by HTTP POST.
# Production Apple callback:
# https://www.suremandarin.com/api/auth/oauth/callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the complete .p8 key, or use literal \n between its lines.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=https://www.suremandarin.com/api/auth/oauth/callback/apple

# Google Cloud Translation Basic (v2). The key is used only by Strapi and is
# never exposed to the website. 15,000 characters/day stays below the usual
# 500,000-character monthly free credit while leaving a safety margin.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_DAILY_CHARACTER_LIMIT=15000

# Future mobile payment channel credentials
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
GOOGLE_PLAY_PACKAGE_NAME=
